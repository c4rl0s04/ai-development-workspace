# Canonical deployment origin, HTTPS except localhost development.
APP_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Numeric stable GitHub account ID, not login name or Supabase UUID.
OWNER_GITHUB_ID=replace-with-numeric-github-id
# Pre-registered PUBLIC OAuth client; token endpoint auth method: none.
MCP_OAUTH_CLIENT_ID=replace-with-public-client-id
# Must match the registered Codex redirect URI exactly (including fixed port).
MCP_OAUTH_REDIRECT_URI=http://127.0.0.1:49152/callback
# Audience is derived from APP_URL + /api/mcp; configure the supplied Auth hook.
# No service-role key, OAuth client secret, or GitHub secret belongs in this app.
